# Base de Datos
DB_PASSWORD=takerpass2026

# JWT
JWT_SECRET=supersecretjwtkey2026

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# WebPay (Testing)
WEBPAY_SECRET=testsecret

# Mercado Pago — usar credenciales de PRUEBA (TEST-...) mientras se desarrolla.
# Se obtienen en https://www.mercadopago.cl/developers/panel/app
# Credenciales reales solo al pasar a producción (ver docs/DEPLOY_VULTR.md).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# 'mercadopago' o 'webpay' — cuál se usa por defecto si el frontend no especifica
PAYMENT_PROVIDER=mercadopago

# Panel de administración (/api/admin/*) — secreto compartido, no hay rol
# admin en la base todavía. Genera uno propio, no dejes el de ejemplo:
#   openssl rand -hex 24
ADMIN_API_KEY=cambiame-con-openssl-rand-hex-24

# Evolution API
EVOLUTION_API_KEY=default

# Producción — dejar como está para desarrollo local. En el VPS, deploy-prod.sh
# los reemplaza automáticamente con tu dominio real (ver docs/DEPLOY_VULTR.md).
FRONTEND_URL=http://localhost:8080
MINIO_PUBLIC_URL=http://localhost:9000
# URL pública por la que Mercado Pago llega a tu webhook — en el VPS es tu
# dominio real + /api (deploy-prod.sh lo configura solo).
BACKEND_PUBLIC_URL=http://localhost:4000

# Puertos internos en producción (solo aplican con docker-compose.prod.yml,
# atados a 127.0.0.1). Cambia APP_PORT si vas a correr esto junto a otro
# stack en el mismo VPS (ej. Divinittys) y el puerto por defecto ya está
# ocupado — deploy-prod.sh lo puede recibir como segundo argumento.
APP_PORT=8080
API_PORT=4000